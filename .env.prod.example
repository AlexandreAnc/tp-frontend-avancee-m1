# Copier en .env à la racine du dépôt sur le VPS (lu par docker-compose.prod.yml).
# Domaine public de l'app, enregistrement DNS A vers l'IP du VPS. Sans domaine : <ip-du-vps>.sslip.io
DOMAIN=dashia.example.com

# Base PostgreSQL : mot de passe long et aléatoire (openssl rand -base64 24)
POSTGRES_USER=app
POSTGRES_PASSWORD=
POSTGRES_DB=app
