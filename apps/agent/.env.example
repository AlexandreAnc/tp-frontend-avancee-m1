SERVER_URL=http://localhost:3000
AGENT_KEY=agk_xxxxxxxx      # clé propre à la machine, générée côté admin
AGENT_NAME=macbook-pro
OLLAMA_URL=http://localhost:11434
CHAT_MODEL=gemma4:26b       # peut varier selon la machine
EMBED_MODEL=bge-m3          # identique sur toutes les machines
AGENT_CONCURRENCY=1         # tâches traitées en parallèle
AGENT_TIMEZONE=Europe/Paris # fuseau utilisé pour interpréter les dates
