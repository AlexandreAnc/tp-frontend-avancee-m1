    "@app/shared": "workspace:*",
    "heic-convert": "^2.1.0",
    "mammoth": "^1.13.0",
    "ollama": "^0.6.4",
    "read-excel-file": "^9.3.12",
    "tsx": "^4.23.15",
    "unpdf": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/heic-convert": "^2.1.1",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
