# Base PostgreSQL + pgvector (docker compose up -d db)
DATABASE_URL=postgres://app:app@localhost:5432/app

# URL publique de l'app et secret Better Auth (openssl rand -base64 32)
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-change-me-change-me-change-me

# Stockage des fichiers uploadés
STORAGE_DIR=./.data/files

# Chiffrement des tokens OAuth : 32 octets en base64 (openssl rand -base64 32)
ENCRYPTION_KEY=

# Web Push : pnpm --filter web vapid:generate
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Connecteur Google Agenda (optionnel). URI de redirection : <BETTER_AUTH_URL>/api/connectors/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Connecteur Philips Hue (optionnel, developers.meethue.com). URI de redirection : <BETTER_AUTH_URL>/api/connectors/hue/callback
HUE_CLIENT_ID=
HUE_CLIENT_SECRET=

# Modèle d'embeddings exigé des agents (identique sur toutes les machines)
EMBED_MODEL=bge-m3

# Emails autorisés à gérer les clés d'agent (séparés par des virgules)
ADMIN_EMAILS=
